{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server/proto/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/rpc/mainnet/:path*",
      "destination": "https://rpc.tari.com/:path*"
    },
    {
      "source": "/rpc/esmeralda/:path*",
      "destination": "https://rpc.esmeralda.tari.com/:path*"
    }
  ]
}
